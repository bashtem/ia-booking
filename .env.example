# Local API configuration.
# Variables already set in the environment take precedence over this file.
# Validated in src/config/env.ts.

NODE_ENV=development

HOST=0.0.0.0
PORT=3000

# fatal, error, warn, info, debug, trace, or silent
LOG_LEVEL=info

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGIN=http://localhost:5173

# Dev Postgres from infra/dev/compose.yaml: user ia, password ia, database ia_booking.
DATABASE_URL=postgres://ia:ia@localhost:5432/ia_booking
